# SAINHE v3 — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real keys.

# FRED API key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
# Used by scripts/fetch_macro_liquidity.py for: WALCL, RRP, TGA, M2, HY OAS, JGB, UK Gilt, China M2
FRED_API_KEY=your_key_here

# Contact email for SEC EDGAR (mandatory User-Agent, sec.gov/os/accessing-edgar-data)
# Used by sainhe_backend/edgar/edgar_client.py. Never hardcode it: the repo is public.
EDGAR_CONTACT_EMAIL=
